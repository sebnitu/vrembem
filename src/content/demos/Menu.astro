---
import Icon from "@/components/Icon.astro";

export interface Props {
  name: string;
  id?: string;
  classes?: string;
}

const { name, id = "", classes = "" } = Astro.props;
---

{
  name == "crud" && (
    <ul id={id} class={`menu ${classes}`.trim()}>
      <li class="menu__item">
        <button type="button" class="menu__action">
          Create
        </button>
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action">
          Read
        </button>
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action">
          Update
        </button>
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action">
          Delete
        </button>
      </li>
      <li class="menu__divider" />
      <li class="menu__item">
        <button type="button" class="menu__action">
          <Icon name="gear-bold" size="sm" class="foreground-primary" />
          <span>Settings</span>
        </button>
      </li>
    </ul>
  )
}

{
  name == "browser" && (
    <ul class={`menu ${classes ? classes : "menu--inline"}`.trim()}>
      <li class="menu__item">
        <button type="button" class="menu__action menu__action--icon">
          <Icon name="arrow-left" />
        </button>
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action menu__action--icon" disabled>
          <Icon name="arrow-right" />
        </button>
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action menu__action--icon">
          <Icon name="arrow-clockwise" />
        </button>
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action menu__action--icon">
          <Icon name="house" />
        </button>
      </li>
      <li class="menu__divider" />
      <li class="menu__item flex-grow margin-x">
        <input
          class="input border-radius-circle padding-x"
          type="url"
          placeholder="https://"
          style="min-width: 240px;"
        />
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action menu__action--icon">
          <Icon name="dots-three-vertical-bold" />
        </button>
      </li>
    </ul>
  )
}

{
  name == "edit" && (
    <ul class={`menu ${classes}`.trim()}>
      <li class="menu__label">Actions</li>
      <li class="menu__item">
        <button type="button" class="menu__action">
          Undo
        </button>
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action">
          Redo
        </button>
      </li>
      <li class="menu__divider" />
      <li class="menu__item">
        <button type="button" class="menu__action">
          Cut
        </button>
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action">
          Copy
        </button>
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action">
          Paste
        </button>
      </li>
    </ul>
  )
}

{
  name == "edit-icons" && (
    <ul class={`menu ${classes}`.trim()}>
      <li class="menu__item">
        <button type="button" class="menu__action">
          <Icon
            name="arrow-u-down-left-bold"
            size="sm"
            class="foreground-primary"
          />
          <span class="flex-grow">Undo</span>
        </button>
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action">
          <Icon
            name="arrow-u-down-right-bold"
            size="sm"
            class="foreground-primary"
          />
          <span class="flex-grow">Redo</span>
        </button>
      </li>
      <li class="menu__divider" />
      <li class="menu__item">
        <button type="button" class="menu__action">
          <Icon name="scissors-bold" size="sm" class="foreground-primary" />
          <span class="flex-grow">Cut</span>
        </button>
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action">
          <Icon name="copy-bold" size="sm" class="foreground-primary" />
          <span class="flex-grow">Copy</span>
        </button>
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action">
          <Icon name="clipboard-bold" size="sm" class="foreground-primary" />
          <span class="flex-grow">Paste</span>
        </button>
      </li>
    </ul>
  )
}

{
  name == "edit-shortcuts" && (
    <ul class={`menu ${classes}`.trim()}>
      <li class="menu__item">
        <button type="button" class="menu__action">
          <span class="flex-grow">Undo</span>
          <span class="foreground-subtle">⌘Z</span>
        </button>
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action">
          <span class="flex-grow">Redo</span>
          <span class="foreground-subtle">&uarr;⌘Z</span>
        </button>
      </li>
      <li class="menu__divider" />
      <li class="menu__item">
        <button type="button" class="menu__action">
          <span class="flex-grow">Cut</span>
          <span class="foreground-subtle">⌘X</span>
        </button>
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action">
          <span class="flex-grow">Copy</span>
          <span class="foreground-subtle">⌘C</span>
        </button>
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action">
          <span class="flex-grow">Paste</span>
          <span class="foreground-subtle">⌘V</span>
        </button>
      </li>
    </ul>
  )
}

{
  name == "edit-all" && (
    <ul class={`menu ${classes}`.trim()}>
      <li class="menu__item">
        <button type="button" class="menu__action">
          <Icon
            name="arrow-u-down-left-bold"
            size="sm"
            class="foreground-primary"
          />
          <span class="flex-grow">Undo</span>
          <span class="foreground-subtle">⌘Z</span>
        </button>
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action">
          <Icon
            name="arrow-u-down-right-bold"
            size="sm"
            class="foreground-primary"
          />
          <span class="flex-grow">Redo</span>
          <span class="foreground-subtle">&uarr;⌘Z</span>
        </button>
      </li>
      <li class="menu__divider" />
      <li class="menu__item">
        <button type="button" class="menu__action">
          <Icon name="scissors-bold" size="sm" class="foreground-primary" />
          <span class="flex-grow">Cut</span>
          <span class="foreground-subtle">⌘X</span>
        </button>
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action">
          <Icon name="copy-bold" size="sm" class="foreground-primary" />
          <span class="flex-grow">Copy</span>
          <span class="foreground-subtle">⌘C</span>
        </button>
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action">
          <Icon name="clipboard-bold" size="sm" class="foreground-primary" />
          <span class="flex-grow">Paste</span>
          <span class="foreground-subtle">⌘V</span>
        </button>
      </li>
    </ul>
  )
}

{
  name == "format-text" && (
    <ul class={`menu ${classes}`.trim()}>
      <li class="menu__item">
        <button type="button" class="menu__action">
          <span class="flex-grow">Bold</span>
          <span class="foreground-subtle">⌘B</span>
        </button>
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action">
          <span class="flex-grow">Italic</span>
          <span class="foreground-subtle">⌘I</span>
        </button>
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action">
          <span class="flex-grow">Underline</span>
          <span class="foreground-subtle">⌘U</span>
        </button>
      </li>
      <li class="menu__divider" />
      <li class="menu__item">
        <button type="button" class="menu__action">
          <span class="flex-grow">Paragraph Styles</span>
          <span class="foreground-subtle arrow-right" />
        </button>
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action">
          <span class="flex-grow">Align</span>
          <span class="foreground-subtle arrow-right" />
        </button>
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action">
          <span class="flex-grow">Line spacing</span>
          <span class="foreground-subtle arrow-right" />
        </button>
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action">
          <span class="flex-grow">Numbered lists</span>
          <span class="foreground-subtle arrow-right" />
        </button>
      </li>
      <li class="menu__item">
        <button type="button" class="menu__action">
          <span class="flex-grow">List options</span>
          <span class="foreground-subtle arrow-right" />
        </button>
      </li>
      <li class="menu__divider" />
      <li class="menu__item">
        <button type="button" class="menu__action">
          <span class="flex-grow">Clear formatting</span>
          <span class="foreground-subtle">⌘/</span>
        </button>
      </li>
    </ul>
  )
}
