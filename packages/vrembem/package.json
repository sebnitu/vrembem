{
  "name": "vrembem",
  "description": "A component library based on the BEM methodology.",
  "version": "4.0.0-next.49",
  "license": "MIT",
  "keywords": [
    "BEM",
    "front-end",
    "component",
    "library"
  ],
  "style": "./dist/index.css",
  "exports": {
    ".": {
      "sass": "./index.scss",
      "style": "./dist/index.css"
    },
    "./layers": {
      "sass": "./layers.scss",
      "style": "./dist/layers.css",
      "default": "./dist/layers.css"
    },
    "./tokens": {
      "sass": "./tokens.scss",
      "style": "./dist/tokens.css",
      "default": "./dist/tokens.css"
    },
    "./base": {
      "sass": "./base.scss",
      "style": "./dist/base.css",
      "default": "./dist/base.css"
    },
    "./components": {
      "sass": "./components.scss",
      "style": "./dist/components.css",
      "default": "./dist/components.css"
    },
    "./utilities": {
      "sass": "./utilities.scss",
      "style": "./dist/utilities.css",
      "default": "./dist/utilities.css"
    },
    "./sass": "./index.scss",
    "./css": "./dist/index.css",
    "./dev/*": "./dev/*",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dev",
    "dist",
    "index.scss",
    "layers.scss",
    "tokens.scss",
    "base.scss",
    "components.scss",
    "utilities.scss"
  ],
  "scripts": {
    "serve": "vite",
    "build": "npm-run-all clean styles",
    "clean": "del dev && del dist",
    "styles": "npm-run-all styles:dev styles:dist",
    "styles:dev": "sass build:dev --load-path=../../node_modules",
    "styles:dist": "sass build:dist --load-path=../../node_modules --style=compressed",
    "watch": "npm run watch:styles",
    "watch:styles": "concurrently 'npm run styles:dev -- --watch' 'npm run styles:dist -- --watch'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebnitu/vrembem.git",
    "directory": "packages/vrembem"
  },
  "homepage": "https://github.com/sebnitu/vrembem#readme",
  "dependencies": {
    "@vrembem/button": "^4.0.0-next.49",
    "@vrembem/card": "^4.0.0-next.49",
    "@vrembem/checkbox": "^4.0.0-next.49",
    "@vrembem/content": "^4.0.0-next.49",
    "@vrembem/core": "^4.0.0-next.49",
    "@vrembem/drawer": "^4.0.0-next.49",
    "@vrembem/flex": "^4.0.0-next.49",
    "@vrembem/grid": "^4.0.0-next.49",
    "@vrembem/icon": "^4.0.0-next.49",
    "@vrembem/input": "^4.0.0-next.49",
    "@vrembem/menu": "^4.0.0-next.49",
    "@vrembem/modal": "^4.0.0-next.49",
    "@vrembem/notice": "^4.0.0-next.49",
    "@vrembem/panel": "^4.0.0-next.49",
    "@vrembem/popover": "^4.0.0-next.49",
    "@vrembem/radio": "^4.0.0-next.49",
    "@vrembem/section": "^4.0.0-next.49",
    "@vrembem/select": "^4.0.0-next.49",
    "@vrembem/switch": "^4.0.0-next.49",
    "@vrembem/table": "^4.0.0-next.49",
    "@vrembem/utility": "^4.0.0-next.49"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "d966f513f86f66dddf93ed60ddefe51124562dc0"
}
