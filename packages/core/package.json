{
  "name": "@vrembem/core",
  "description": "Provides a number of Sass and JavaScript modules that make up the shared systems and configurations of the Vrembem library.",
  "version": "4.0.0-next.46",
  "license": "MIT",
  "keywords": [
    "BEM",
    "front-end",
    "component",
    "core"
  ],
  "style": "./dist/index.css",
  "exports": {
    ".": {
      "sass": "./index.scss",
      "style": "./dist/index.css"
    },
    "./layers": {
      "sass": "./layers.scss",
      "style": "./dist/layers.css",
      "default": "./layers.scss"
    },
    "./tokens": {
      "sass": "./src/modules/_tokens.scss",
      "style": "./dist/tokens.css",
      "default": "./src/modules/_tokens.scss"
    },
    "./base": {
      "sass": "./base.scss",
      "style": "./dist/base.css",
      "default": "./base.scss"
    },
    "./config": "./src/modules/_config.scss",
    "./palette": "./src/modules/_palette.scss",
    "./breakpoints": "./src/modules/_breakpoints.scss",
    "./themes": "./src/modules/_themes.scss",
    "./dev/*": "./dev/*",
    "./dist/*": "./dist/*",
    "./*": "./src/*"
  },
  "files": [
    "dev",
    "dist",
    "src",
    "index.scss",
    "layers.scss",
    "base.scss",
    "config.scss",
    "tokens.scss",
    "palette.scss",
    "breakpoints.scss",
    "themes.scss"
  ],
  "scripts": {
    "serve": "vite",
    "build": "npm-run-all clean styles",
    "clean": "del dev && del dist",
    "styles": "npm-run-all styles:dev styles:dist",
    "styles:dev": "sass index.scss dev/index.css --load-path=../../node_modules",
    "styles:dist": "sass index.scss dist/index.css --load-path=../../node_modules --style=compressed",
    "watch": "npm run watch:styles",
    "watch:styles": "concurrently 'npm run styles:dev -- --watch' 'npm run styles:dist -- --watch'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebnitu/vrembem.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/sebnitu/vrembem/tree/main/packages/core#readme",
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "d966f513f86f66dddf93ed60ddefe51124562dc0"
}
