---
import "@/styles/app.scss";

interface Props {
  title?: string;
  bodyClass?: string;
}

const { title, bodyClass } = Astro.props;
---

<!doctype html>
<html lang="en" data-mode="auto" data-theme="default">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#F3F2F1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="generator" content={Astro.generator} />
    <title>Vrembem{title ? " | " + title : ""}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        const local = localStorage.getItem("VB:Profile");
        const store = local ? JSON.parse(local) : {};
        document.documentElement.dataset.mode = store.mode || "auto";
        document.documentElement.dataset.theme = store.theme || "default";
      })();
    </script>
    <script>
      import "vrembem/define";
    </script>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
