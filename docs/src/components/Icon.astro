---
import Svg from "@/components/Svg.astro";

interface Props {
  name: string;
  class?: string;
  size?: "xs" | "sm" | "lg" | "xl";
  style?: "stroke" | "fill" | "both";
}

const { name, class: classString, size, style, ...attrs } = Astro.props;

const iconName = `icons/${name}`;
const iconClasses = [
  "icon",
  size && `icon--size-${size}`,
  style && `icon--style-${style}`,
  classString
]
  .filter(Boolean)
  .join(" ");
---

<Svg name={iconName} class={iconClasses} {...attrs} />
