---
import type { NaviItem, NaviLink } from "@/modules/navigation";

interface Props {
  tree: NaviItem[];
  nested?: boolean;
}

const { tree, nested } = Astro.props;

function classes(entry: NaviLink) {
  return { "is-active": entry.isActive, "is-parent": entry.isParent };
}

let category = "";

function maybeOutputLabel(entry: NaviLink) {
  if (entry.data.category && category !== entry.data.category) {
    category = entry.data.category;
    return category !== "Core";
  } else {
    return false;
  }
}
---

<ul class={`menu menu--collection ${nested ? "is-nested" : ""}`.trim()}>
  {
    tree.map((entry) =>
      "group" in entry ? (
        <li class="menu__item">
          <details
            open={!entry.collapsed}
            data-active={entry.isParent || undefined}
          >
            <summary>
              <span>{entry.label}</span>
              <span class="spacer" />
              <span class="caret" />
            </summary>
            <vb-sidebar-group />
            <Astro.self tree={entry.group} nested />
          </details>
        </li>
      ) : (
        <>
          {maybeOutputLabel(entry) && (
            <li class="menu__label">{entry.data.category}</li>
          )}
          <li class="menu__item">
            <a class:list={["menu__action", classes(entry)]} href={entry.link}>
              {entry.label}
            </a>
          </li>
        </>
      )
    )
  }
</ul>
