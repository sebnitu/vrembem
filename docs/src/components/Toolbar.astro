---
import Icon from "@/components/Icon.astro";

interface Props {
  layout: {
    hasAside: boolean;
    hasSidebar: boolean;
  };
}

const { layout } = Astro.props;
---

{
  (layout.hasSidebar || layout.hasAside) && (
    <div class="toolbar">
      {layout.hasSidebar && (
        <button
          commandfor="layout-sidebar-modal"
          command="show-modal"
          class="button"
        >
          <Icon name="sidebar" classes="icon--size-sm" />
          <span class="text-capitalize">Sidebar</span>
        </button>
      )}
      {layout.hasAside && (
        <button
          commandfor="main-aside-modal"
          command="show-modal"
          class="button margin-left-auto"
        >
          <span>On this page</span>
          <Icon name="map-pin" classes="icon--size-sm" />
        </button>
      )}
    </div>
  )
}
