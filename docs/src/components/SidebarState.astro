<vb-sidebar-state>
  <script is:inline>
    (() => {
      // Store the scroll position if one was stored in session
      const state = JSON.parse(sessionStorage.getItem("vb-sidebar-state"));
      window._vbSidebarScrollPosition = state?.scroll || 0;

      // Return if there is no open states stored
      if (!state?.open) return;

      // Define vb-sidebar-group and restore the opened state
      let index = 0;
      customElements.define(
        "vb-sidebar-group",
        class extends HTMLElement {
          #initialized = false;
          connectedCallback() {
            if (this.#initialized) return;
            this.#initialized = true;
            const details = this.closest("details");
            if (details) {
              details.open =
                details.hasAttribute("data-active") || state.open[index];
            }
            index++;
          }
        }
      );
    })();
  </script>
  <slot />
  <script is:inline>
    // Restore the scroll position if one was stored then delete the global var
    (() => {
      const sidebar = document.getElementById("layout-sidebar");
      if (!window._vbSidebarScrollPosition || !sidebar) return;
      sidebar.scrollTop = window._vbSidebarScrollPosition;
      delete window._vbSidebarScrollPosition;
    })();
  </script>
</vb-sidebar-state>

<script>
  // Setup a storage session
  import { storage } from "@/modules/storage";
  const store = storage("vb-sidebar-state", "session");

  // Whenever a detail is toggled, store the state array
  const details = document.querySelectorAll("vb-sidebar-state details");
  details.forEach((entry) => {
    entry.addEventListener("toggle", () => {
      const stateArray = Array.from(details, (el) => el.hasAttribute("open"));
      store.set("open", stateArray);
    });
  });

  // Store the scroll position of the drawer if a link is clicked
  const sidebar = document.getElementById("layout-sidebar");
  document.addEventListener("click", (event) => {
    const link = (event.target as HTMLElement).closest("a");
    if (!link) return;
    const storeScroll = link.closest("vb-sidebar-state");
    store.set("scroll", storeScroll ? sidebar?.scrollTop : 0);
  });
</script>
