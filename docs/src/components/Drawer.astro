---
interface Props {
  id: string;
  breakpoint?: string;
  classes?: string;
}

const { id, breakpoint, classes = "" } = Astro.props;
---

<vb-drawer {id} class={`drawer ${classes}`.trim()} breakpoint={breakpoint}>
  <div class="drawer__panel">
    <div class="drawer__container">
      <slot />
    </div>
  </div>
</vb-drawer>

<script>
  import "@vrembem/drawer";
</script>
