---
import Icon from "@/components/Icon.astro";

interface Props {
  nopre?: boolean;
  inline?: string;
  icon?: string;
}

const { inline, nopre, icon } = Astro.props;
const uid = `${Math.floor(Math.random() * Date.now())}`;
const classes = ["code-block"];
if (inline) classes.push("code-block--inline");
if (icon) classes.push("has-icon");
---

<div class={classes.join(" ")}>
  {
    icon && (
      <span class="code-block__icon">
        <Icon name={icon} size="sm" />
      </span>
    )
  }
  {
    nopre ? (
      <slot />
    ) : inline ? (
      // prettier-ignore
      <pre tabindex="0" class="pre"><code set:html={inline} /></pre>
    ) : (
      // prettier-ignore
      <pre tabindex="0" class="pre"><slot /></pre>
    )
  }
  <button
    type="button"
    popovertarget={`popover-${uid}`}
    class="code-block__copy-button"
    aria-label="Copy code example to clipboard"
  >
    <Icon name="copy-bold" size="sm" />
    <Icon name="check-bold" size="sm" class="foreground-primary display-none" />
  </button>
  <div
    id={`popover-${uid}`}
    class="popover popover--tooltip popover--arrow-bottom"
    popover="hint"
  >
    Copied!
  </div>
</div>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>(
    ".code-block__copy-button"
  );
  btns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const block = btn.closest(".code-block");
      const targetId = btn.getAttribute("popovertarget");
      if (!block || !targetId) return;

      const code = block.querySelector("pre code");
      if (!(code instanceof HTMLElement)) return;

      const text = code.innerText;
      const icons = btn.querySelectorAll("svg");
      const popover = document.getElementById(targetId);

      navigator.clipboard
        .writeText(text)
        .then(() => {
          btn.disabled = true;
          btn.classList.add("is-copied");
          icons.forEach((icon) => icon.classList.toggle("display-none"));
          setTimeout(() => {
            btn.disabled = false;
            btn.classList.remove("is-copied");
            icons.forEach((icon) => icon.classList.toggle("display-none"));
            popover?.hidePopover();
          }, 2000);
        })
        .catch((error) => {
          console.error("Error:", error);
        });
    });
  });
</script>
