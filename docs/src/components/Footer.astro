---
import Svg from "@/components/Svg.astro";

interface Props {
  class?: string;
}

const { class: classString } = Astro.props;

const classes = ["footer", classString].filter(Boolean).join(" ");
---

<footer class={classes}>
  <div class="footer__copy">
    <p>
      Vrembem is released under the MIT License.<br />
      Copyright 2026 Sebastian Nitu.
    </p>
  </div>
  <div class="footer__logo">
    <a href="/">
      <Svg name="vrembem-icon" />
    </a>
  </div>
</footer>
