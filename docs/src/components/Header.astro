---
import Navi from "@/components/Navi.astro";
import Modal from "@/components/Modal.astro";
import Svg from "@/components/Svg.astro";
import Icon from "@/components/Icon.astro";
import pkg from "../../../packages/vrembem/package.json";

interface Props {
  class?: string;
}

const { class: classString = "" } = Astro.props;

const classes = ["header", classString].filter(Boolean).join(" ");
const version = pkg.version;
---

<header class={classes}>
  <div class="header__container">
    <div class="header__title">
      <a class="skip-link button button--color-primary" href="#main">
        Skip to content
      </a>
      <a href="/" class="brand">
        <Svg name="vrembem-icon" width={24} height={24} class="brand__icon" />
        <strong class="brand__name">Vrembem</strong>
        <span class="brand__version">v{version}</span>
      </a>
    </div>
    <div class="header__menu">
      <Navi classes="display-none md:display-flex" inline />
      <button
        type="button"
        command="show-modal"
        commandfor="modal-navi"
        class="button button--icon display-block md:display-none"
        aria-label="Open navigation menu"
      >
        <Icon name="list" />
      </button>
    </div>
  </div>
</header>

<Modal id="modal-navi" classes="modal--pos-top modal--size-sm panel">
  <div class="panel__header">
    <h2 class="panel__title">Menu</h2>
    <button
      type="button"
      command="close"
      commandfor="modal-navi"
      class="button button--icon button--size-sm"
      aria-label="Close navigation menu"
    >
      <Icon name="x" />
    </button>
  </div>
  <div class="panel__body">
    <Navi />
  </div>
</Modal>
