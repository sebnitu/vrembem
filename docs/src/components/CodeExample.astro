---
import fs from "node:fs";
import path from "node:path";
import { Code } from "astro:components";
import CodeBlock from "@/components/CodeBlock.astro";
import ResetExampleButton from "./ResetExampleButton.astro";
import Tabs from "@/components/Tabs.astro";
import TabsPanel from "@/components/TabsPanel.astro";
import Icon from "@/components/Icon.astro";

interface TabFile {
  label: string;
  file?: string;
  code?: string;
}

interface Props {
  label?: string;
  lang?: string;
  style?: string;
  iframe?: string;
  tabs?: boolean | TabFile[];
  tabsLabel?: string;
  tabsSyncKey?: string;
  flush?: boolean;
  resettable?: boolean;
  expandable?: boolean;
}

const {
  label,
  lang = "html",
  style,
  iframe,
  tabs,
  tabsLabel,
  tabsSyncKey,
  flush,
  resettable,
  expandable
} = Astro.props;

const uid = JSON.stringify(Math.floor(Math.random() * Date.now()));

const classes: string[] = [];
if (expandable) classes.push("code-example--expandable", "is-scroll-locked");

function getFileContent(filePath: string) {
  return fs.readFileSync(path.join(process.cwd(), filePath), "utf-8");
}

function getTabCode(tab: TabFile) {
  return tab.code ?? getFileContent(tab.file!);
}
---

<div class={`code-example ${classes.join(" ")}`.trim()} {style}>
  {
    Astro.slots.has("demo") && (
      <div class="code-example__demo">
        <slot name="demo" />
      </div>
    )
  }
  {
    Astro.slots.has("output") && (
      <div id={`code-example-output-${uid}`} class="code-example__output">
        <div class={`code-example__inner ${flush ? "padding-0" : ""}`.trim()}>
          <slot name="output" />
        </div>
      </div>
    )
  }
  {
    iframe && (
      <div class="code-example__output">
        <iframe src={iframe} />
      </div>
    )
  }
  {
    !tabs && (
      <div class="code-example__toolbar">
        <div class="flex-grow">{label || lang?.toUpperCase()}</div>
        {resettable && (
          <ResetExampleButton target={`code-example-output-${uid}`} />
        )}
      </div>
    )
  }
  {
    (tabs || Astro.slots.has("default")) && (
      <div class="code-example__input">
        {expandable && (
          <div class="code-example__actions">
            <span class="button button--size-sm background scroll-lock-hint">
              <Icon name="lock-simple-open-bold" size="sm" />
              <span>Unlock scroll</span>
            </span>
            <button
              type="button"
              class="button button--size-sm button--variant-solid button--color-primary"
              data-action="toggle-expand"
            >
              Expand
            </button>
          </div>
          <div class="scroll-lock-screen"></div>
        )}
        {!tabs && <slot />}
        {tabs === true && (
          <Tabs syncKey={tabsSyncKey} label={tabsLabel}>
            <slot />
          </Tabs>
        )}
        {Array.isArray(tabs) && (
          <Tabs syncKey={tabsSyncKey} label={tabsLabel}>
            {tabs.map((tab: TabFile) => (
              <TabsPanel label={tab.label}>
                <CodeBlock nopre>
                  <Code
                    code={getTabCode(tab)}
                    lang={lang as any}
                    theme="css-variables"
                    class="pre"
                  />
                </CodeBlock>
              </TabsPanel>
            ))}
          </Tabs>
        )}
      </div>
    )
  }
  {
    iframe && (
      <div class="code-example__input">
        <CodeBlock nopre>
          <Code
            code={getFileContent(path.join("public", iframe))}
            lang="html"
            theme="css-variables"
            class="pre"
          />
        </CodeBlock>
      </div>
    )
  }
</div>

<script>
  const padding = 42; // Kind of a magic number atm

  function getActiveCode(parent: HTMLElement): HTMLElement | null {
    const activePanel = parent.querySelector(
      "[role='tabpanel'].is-active"
    ) as HTMLElement | null;
    return (activePanel ?? parent).querySelector("code");
  }

  function updateMaxHeight(parent: HTMLElement) {
    if (!parent.classList.contains("is-expanded")) return;
    const code = getActiveCode(parent);
    if (!code) return;
    const height = code.offsetHeight + padding;
    parent.style.setProperty("--vb-code-example-max-height", `${height}px`);
  }

  const btns = document.querySelectorAll("[data-action='toggle-expand']");
  btns.forEach((btn) => {
    const parent = btn.closest(".code-example") as HTMLElement;

    btn.addEventListener("click", () => {
      // Toggle the expand state
      parent.classList.toggle("is-expanded");

      // Update the state
      if (parent.classList.contains("is-expanded")) {
        btn.innerHTML = "Collapse";
        updateMaxHeight(parent);
      } else {
        btn.innerHTML = "Expand";
        parent.style.setProperty("--vb-code-example-max-height", null);
      }
    });

    // Recalculate the max height when switching tabs so expanded examples
    // stay sized to the currently visible panel
    parent.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("[role='tab']")) {
        requestAnimationFrame(() => updateMaxHeight(parent));
      }
    });
    parent.addEventListener("tabs-sync-change", () => {
      requestAnimationFrame(() => updateMaxHeight(parent));
    });
  });

  document.querySelectorAll(".is-scroll-locked").forEach((screen) => {
    screen.addEventListener("click", () => {
      screen.classList.remove("is-scroll-locked");
    });
  });
</script>
