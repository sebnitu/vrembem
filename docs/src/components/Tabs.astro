---
interface Props {
  syncKey?: string;
  label?: string;
}

const { syncKey, label } = Astro.props;
---

<vb-tabs sync-key={syncKey} label={label}>
  <slot />
</vb-tabs>

<script>
  import { storage } from "@/modules/storage";

  const profile = storage("VB:Tabs");

  class Tabs extends HTMLElement {
    #initialized = false;
    syncKey: string | null = null;
    tabs: HTMLButtonElement[] = [];

    connectedCallback() {
      // Only run this if it hasn't been initialized
      if (this.#initialized) return;
      this.#initialized = true;

      // Add a unique ID if one doesn't exist
      if (!this.id) {
        this.setAttribute(
          "id",
          `tabs-${Math.floor(Math.random() * Date.now())}`
        );
      }

      // Store the sync key
      this.syncKey = this.getAttribute("sync-key");

      // Build the tab menu
      const panels = this.querySelectorAll("[role='tabpanel']");
      const tablist = document.createElement("div");
      tablist.setAttribute("role", "tablist");

      // Apply the label to the tablist if set
      const tablistLabel = this.getAttribute("label");
      if (tablistLabel) {
        tablist.setAttribute("aria-label", tablistLabel);
      }

      // Loop through the panels
      panels.forEach((panel) => {
        // Generate a unique ID
        const uid = Math.floor(Math.random() * Date.now());

        // Apply the ID to the panel
        panel.setAttribute("id", `tabpanel-${uid}`);
        panel.setAttribute("aria-labelledby", `tab-${uid}`);

        // Create the tab button
        const tab = document.createElement("button");
        tab.setAttribute("role", "tab");
        tab.setAttribute("aria-controls", `tabpanel-${uid}`);
        tab.setAttribute("id", `tab-${uid}`);
        tab.innerText = panel.getAttribute("data-label") ?? "";
        tablist.append(tab);
      });

      // Apply the menu
      this.prepend(tablist);

      // Store the tab buttons
      this.tabs = Array.from(this.querySelectorAll("[role='tab']")) as HTMLButtonElement[];

      // Select the initial tab
      initialTab(this);

      // Setup event listeners for tabs
      this.tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          selectTab(tab, this);
        });

        const __handlerKeydown = handlerKeydown.bind(null, this);

        tab.addEventListener("focus", () => {
          document.addEventListener("keydown", __handlerKeydown);
        });

        tab.addEventListener("blur", () => {
          document.removeEventListener("keydown", __handlerKeydown);
        });
      });

      // Add event listener for when a synced key changed
      document.addEventListener("tabs-sync-change", (event) => {
        const customEvent = event as CustomEvent<{ key: string; label: string }>;

        if (this.syncKey === customEvent.detail.key && event.target !== this) {
          selectTab(customEvent.detail.label, this, false);
        }
      });
    }
  }

  function selectTab(active: HTMLButtonElement | string, entry: Tabs, recursive = true) {
    // Run selectTab on all synced tabs
    if (entry.syncKey && recursive) {
      // Store the syncKey in local storage
      profile.set(entry.syncKey, getTabLabel(active));
      // Dispatch the tabs sync change event
      entry.dispatchEvent(new CustomEvent("tabs-sync-change", {
        bubbles: true,
        detail: {
          key: entry.syncKey,
          label: getTabLabel(active)
        }
      }));
    }
    
    // Select the active tab panel
    entry.tabs.forEach((tab) => {
      const tabpanel = document.querySelector(
        `#${tab.getAttribute("aria-controls")}`
      );
      if (!tabpanel) return;
      if (getTabLabel(active) === getTabLabel(tab)) {
        tab.setAttribute("aria-selected", "true");
        tab.removeAttribute("tabindex");
        tabpanel.classList.add("is-active");
      } else {
        tab.setAttribute("aria-selected", "false");
        tab.setAttribute("tabindex", "-1");
        tabpanel.classList.remove("is-active");
      }
    });
  }

  function selectNextTab(entry: Tabs) {
    let nextTab = document.activeElement?.nextElementSibling as HTMLButtonElement;
    nextTab = nextTab ? nextTab : entry.tabs[0];
    selectTab(nextTab, entry);
    nextTab.focus();
  }

  function selectPrevTab(entry: Tabs) {
    let prevTab = document.activeElement?.previousElementSibling as HTMLButtonElement;
    prevTab = prevTab ? prevTab : entry.tabs[entry.tabs.length - 1];
    selectTab(prevTab, entry);
    prevTab.focus();
  }

  function handlerKeydown(entry: Tabs, event: KeyboardEvent) {
    switch (event.key) {
      case "Down":
      case "ArrowDown":
      case "Right":
      case "ArrowRight":
        event.preventDefault();
        selectNextTab(entry);
        break;
      case "Up":
      case "ArrowUp":
      case "Left":
      case "ArrowLeft":
        event.preventDefault();
        selectPrevTab(entry);
        break;
      default:
        return;
    }
  }

  function getTabLabel(tab: HTMLButtonElement | string) {
    return typeof tab !== "string" ? tab.textContent?.trim() : tab;
  }

  function initialTab(entry: Tabs) {
    const storedValue = entry.syncKey
      ? profile.get(entry.syncKey)
      : null;
    selectTab(storedValue ?? entry.tabs[0], entry, false);
  }

  // Define the tabs custom element if it doesn't exist
  if (!customElements.get("vb-tabs")) {
    customElements.define("vb-tabs", Tabs);
  }
</script>
