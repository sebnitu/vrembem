---
import Root from "@/layouts/Root.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import CodeBlock from "@/components/CodeBlock.astro";
---

<Root bodyClass="is-home background-shift">
  <Header classes="fold-shadow" />
  <div class="header-spacer"></div>
  <main id="main" tabindex="-1">
    <div class="section section--padding-xl">
      <div class="section__container text-align-center">
        <h1 class="vrembem-logo">
          <span class="sr-only">Vrembem</span>
        </h1>
        <p class="font-size-lg margin-bottom-xl">
          A component library based on the BEM methodology.
        </p>
        <div class="hero-actions">
          <a href="/guide" class="button button--color-primary">
            Get Started
          </a>
          <a href="/packages/core" class="button button--color-secondary">
            Documentation
          </a>
          <CodeBlock icon="terminal" inline="npm install vrembem" />
        </div>
      </div>
    </div>

    <div class="section padding-y-0">
      <div class="section__container">
        <div class="grid sm:grid--cols-2 lg:grid--cols-3">
          <div class="card card--feature gap-sm">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              fill="currentcolor"
              viewBox="0 0 256 256"
              class="icon icon--style-fill icon--size-lg foreground-primary"
              ><path
                d="M224,64H176V56a24,24,0,0,0-24-24H104A24,24,0,0,0,80,56v8H32A16,16,0,0,0,16,80V192a16,16,0,0,0,16,16H224a16,16,0,0,0,16-16V80A16,16,0,0,0,224,64ZM96,56a8,8,0,0,1,8-8h48a8,8,0,0,1,8,8v8H96ZM224,80v32H192v-8a8,8,0,0,0-16,0v8H80v-8a8,8,0,0,0-16,0v8H32V80Zm0,112H32V128H64v8a8,8,0,0,0,16,0v-8h96v8a8,8,0,0,0,16,0v-8h32v64Z"
              ></path></svg
            >
            <h2 class="font-size-lg">BEM Methodoloy</h2>
            <p class="text-wrap-pretty">
              Built on the BEM naming convention to improve clarity, prevent
              style conflicts, and keep components clean and maintainable.
            </p>
          </div>
          <div class="card card--feature gap-sm">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              fill="currentcolor"
              viewBox="0 0 256 256"
              class="icon icon--style-fill icon--size-lg foreground-primary"
              ><path
                d="M58.34,101.66l-32-32a8,8,0,0,1,0-11.32l32-32A8,8,0,0,1,69.66,37.66L43.31,64,69.66,90.34a8,8,0,0,1-11.32,11.32Zm40,0a8,8,0,0,0,11.32,0l32-32a8,8,0,0,0,0-11.32l-32-32A8,8,0,0,0,98.34,37.66L124.69,64,98.34,90.34A8,8,0,0,0,98.34,101.66ZM200,40H176a8,8,0,0,0,0,16h24V200H56V136a8,8,0,0,0-16,0v64a16,16,0,0,0,16,16H200a16,16,0,0,0,16-16V56A16,16,0,0,0,200,40Z"
              ></path></svg
            >
            <h2 class="font-size-lg">CSS Variables</h2>
            <p class="text-wrap-pretty">
              Powered by CSS variables to give better design control and
              consistency across multiple components.
            </p>
          </div>
          <div class="card card--feature gap-sm">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              fill="currentcolor"
              viewBox="0 0 256 256"
              class="icon icon--style-fill icon--size-lg foreground-primary"
              ><path
                d="M200.77,53.89A103.27,103.27,0,0,0,128,24h-1.07A104,104,0,0,0,24,128c0,43,26.58,79.06,69.36,94.17A32,32,0,0,0,136,192a16,16,0,0,1,16-16h46.21a31.81,31.81,0,0,0,31.2-24.88,104.43,104.43,0,0,0,2.59-24A103.28,103.28,0,0,0,200.77,53.89Zm13,93.71A15.89,15.89,0,0,1,198.21,160H152a32,32,0,0,0-32,32,16,16,0,0,1-21.31,15.07C62.49,194.3,40,164,40,128a88,88,0,0,1,87.09-88h.9a88.35,88.35,0,0,1,88,87.25A88.86,88.86,0,0,1,213.81,147.6ZM140,76a12,12,0,1,1-12-12A12,12,0,0,1,140,76ZM96,100A12,12,0,1,1,84,88,12,12,0,0,1,96,100Zm0,56a12,12,0,1,1-12-12A12,12,0,0,1,96,156Zm88-56a12,12,0,1,1-12-12A12,12,0,0,1,184,100Z"
              ></path></svg
            >
            <h2 class="font-size-lg">Theming System</h2>
            <p class="text-wrap-pretty">
              Quickly build custom themes with Vrembem's core theming system,
              including seamless light and dark mode support.
            </p>
          </div>
          <div class="card card--feature gap-sm">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              fill="currentcolor"
              viewBox="0 0 256 256"
              class="icon icon--style-fill icon--size-lg foreground-primary"
              ><path
                d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216ZM112,80a16,16,0,1,1,16,16A16,16,0,0,1,112,80Zm72,32a8,8,0,0,1-8,8H136v13.58l30.66,46a8,8,0,0,1-13.32,8.88l-25.34-38-25.34,38a8,8,0,1,1-13.32-8.88l30.66-46V120H80a8,8,0,0,1,0-16h96A8,8,0,0,1,184,112Z"
              ></path></svg
            >
            <h2 class="font-size-lg">Accessible</h2>
            <p class="text-wrap-pretty">
              Designed for accessibility, ensuring components are
              keyboard-friendly, screen-reader ready, and usable by everyone.
            </p>
          </div>
          <div class="card card--feature gap-sm">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              fill="currentcolor"
              viewBox="0 0 256 256"
              class="icon icon--style-fill icon--size-lg foreground-primary"
              ><path
                d="M220.27,158.54a8,8,0,0,0-7.7-.46,20,20,0,1,1,0-36.16A8,8,0,0,0,224,114.69V72a16,16,0,0,0-16-16H171.78a35.36,35.36,0,0,0,.22-4,36.11,36.11,0,0,0-11.36-26.24,36,36,0,0,0-60.55,23.62,36.56,36.56,0,0,0,.14,6.62H64A16,16,0,0,0,48,72v32.22a35.36,35.36,0,0,0-4-.22,36.12,36.12,0,0,0-26.24,11.36,35.7,35.7,0,0,0-9.69,27,36.08,36.08,0,0,0,33.31,33.6,35.68,35.68,0,0,0,6.62-.14V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V165.31A8,8,0,0,0,220.27,158.54ZM208,208H64V165.31a8,8,0,0,0-11.43-7.23,20,20,0,1,1,0-36.16A8,8,0,0,0,64,114.69V72h46.69a8,8,0,0,0,7.23-11.43,20,20,0,1,1,36.16,0A8,8,0,0,0,161.31,72H208v32.23a35.68,35.68,0,0,0-6.62-.14A36,36,0,0,0,204,176a35.36,35.36,0,0,0,4-.22Z"
              ></path></svg
            >
            <h2 class="font-size-lg">Modular</h2>
            <p class="text-wrap-pretty">
              Built with modularity in mind so you can include only what's
              necessary and keep your project lean.
            </p>
          </div>
          <div class="card card--feature gap-sm">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              fill="currentcolor"
              viewBox="0 0 256 256"
              class="icon icon--style-fill icon--size-lg foreground-primary"
              ><path
                d="M136,120v96a8,8,0,0,1-16,0V120a8,8,0,0,1,16,0Zm64,72a8,8,0,0,0-8,8v16a8,8,0,0,0,16,0V200A8,8,0,0,0,200,192Zm24-32H208V40a8,8,0,0,0-16,0V160H176a8,8,0,0,0,0,16h48a8,8,0,0,0,0-16ZM56,160a8,8,0,0,0-8,8v48a8,8,0,0,0,16,0V168A8,8,0,0,0,56,160Zm24-32H64V40a8,8,0,0,0-16,0v88H32a8,8,0,0,0,0,16H80a8,8,0,0,0,0-16Zm72-48H136V40a8,8,0,0,0-16,0V80H104a8,8,0,0,0,0,16h48a8,8,0,0,0,0-16Z"
              ></path></svg
            >
            <h2 class="font-size-lg">Customizable</h2>
            <p class="text-wrap-pretty">
              Highly customizable using CSS and Sass variables, giving you full
              control over colors, spacing, and component styling.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="section">
      <div class="section__container">
        <Footer />
      </div>
    </div>
  </main>
</Root>
