    "dark": "var(--vb-neutral-75)"
  },
  "--vb-important-background": {
    "light": "var(--vb-important-75)",
    "dark": "var(--vb-important-600)"
  },
  "--vb-important-foreground": {
    "light": "var(--vb-important-600)",
    "dark": "var(--vb-important-75)"
  },
  "--vb-border-color": {
    "light": "oklch(0% 0 0deg / 0.1)",
    "dark": "oklch(100% 0 0deg / 0.1)"
  },
  "--vb-border-color-strong": {
    "light": "oklch(0% 0 0deg / 0.2)",
    "dark": "oklch(100% 0 0deg / 0.2)"
  },
  "--vb-border-color-stronger": {
    "light": "oklch(0% 0 0deg / 0.3)",
    "dark": "oklch(100% 0 0deg / 0.3)"
  },
  "--vb-shadow-color": {
    "light": "oklch(40% var(--vb-neutral-c) var(--vb-neutral-h) / 8%)",
    "dark": "oklch(22% var(--vb-neutral-c) var(--vb-neutral-h) / 80%)"
  },
  "--vb-box-shadow-outline-color": {
    "light": "oklch(40% var(--vb-neutral-c) var(--vb-neutral-h) / 8%)",
    "dark": "oklch(98% calc(var(--vb-neutral-c) * 0.1) var(--vb-neutral-h) / 8%)"
  },
  "--vb-drop-shadow-outline-color": {
    "light": "oklch(40% var(--vb-neutral-c) var(--vb-neutral-h) / 32%)",
    "dark": "oklch(98% calc(var(--vb-neutral-c) * 0.1) var(--vb-neutral-h) / 32%)"
  }
}
